{
  "name": "scrap2sync-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "contract:generate": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.0",
    "framer-motion": "13.2.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
