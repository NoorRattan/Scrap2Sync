# Public web configuration; never put provider credentials in NEXT_PUBLIC values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_SYNC_ORB=true
NEXT_TELEMETRY_DISABLED=1

# API defaults. Copy only to an ignored, local .env if desired; loading is explicit.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
FORMATTER_PROVIDER=disabled
FORMATTER_MODEL=
FORMATTER_API_KEY=
FORMATTER_PRIVACY_VERIFIED=false
FORMATTER_TIMEOUT_SECONDS=8
MAX_RAW_NOTES_CHARS=10000
MAX_REQUEST_BYTES=65536
MAX_DRAFT_CHARS=20000
MAX_DRAFT_ITEM_CHARS=10000
RATE_LIMIT_PER_MINUTE=10
MAX_PROVIDER_CONCURRENCY=8
MAX_QUEUE_DEPTH=16
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=30
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=INFO
# Public deployment requires explicit operator decisions; these are not approval.
PROVIDER_MONTHLY_BUDGET_APPROVED=false
DEPLOYMENT_LIMITS_VERIFIED=false
